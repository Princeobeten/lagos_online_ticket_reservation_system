# MongoDB connection string.
# Local install:  mongodb://127.0.0.1:27017/lagos_otrs
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>/lagos_otrs
MONGODB_URI=mongodb://127.0.0.1:27017/lagos_otrs

# Signs the session cookie and the QR ticket signature.
# Generate one with:  openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string

# Where the app is reachable. Used for payment callbacks and QR ticket links.
APP_URL=http://localhost:3000

# Paystack test keys from https://dashboard.paystack.com/#/settings/developers
# Leave PAYSTACK_SECRET_KEY blank to use the built-in sandbox checkout screen.
PAYSTACK_SECRET_KEY=

# Password for the seeded administrator account (default: admin12345)
ADMIN_PASSWORD=
